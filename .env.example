# ---- AI (at least one) ----
# Claude reads documents and answers questions when set (preferred).
ANTHROPIC_API_KEY=
# OpenAI powers natural Bangla voice (STT/TTS) and memory embeddings, and is the
# fallback AI for analysis/chat (or the only one if no Anthropic key).
OPENAI_API_KEY=
# Optional model overrides
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-5-mini
# OPENAI_TTS_VOICE=marin

# ---- Database: accounts + vector memory (Postgres with pgvector) ----
# Neon / Supabase / Vercel Postgres connection string. Required in production for accounts.
DATABASE_URL=
# Local dev only: embedded Postgres (PGlite) is used automatically when DATABASE_URL is empty.

# ---- Security ----
# 32+ random characters; encrypts paid reports. Generate: openssl rand -base64 48
REPORT_SECRET=
# Extra allowed origins for API calls (comma-separated), e.g. a custom domain.
# ALLOWED_ORIGINS=https://probashi.ai
# Token for the detailed /api/health report (16+ chars), sent as x-health-token.
HEALTH_TOKEN=
# Shared rate limits across serverless instances (recommended in production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Global daily cap on AI calls (protects your bill).
AI_DAILY_LIMIT=2000

# ---- Payments ----
# demo = no real charge. live requires the bKash/SSLCommerz integration (not enabled yet).
PAYMENT_MODE=demo

# ---- Agencies, legal aid, staff ----
# Staff roles by phone (applied at login): legal = caseworker dashboard, admin = also licence-list import.
STAFF_PHONES=
# Vercel cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/reverify (daily licence re-check).
CRON_SECRET=
# Demo only: use the fictional agencies instead of an imported RAIMS licence list.
# DEMO_REGISTRY=1

# ---- AI phone line (OpenAI Realtime SIP) ----
PHONE_LINE_ENABLED=0
# From OpenAI dashboard -> Project -> Webhooks (event realtime.call.incoming -> https://<domain>/api/phone/incoming)
OPENAI_WEBHOOK_SECRET=
# Shown on the website, e.g. 09610-XXXXXX
PHONE_LINE_NUMBER=
# Human caseworker line for transfers, e.g. tel:+8809610XXXXXX
PHONE_TRANSFER_TO=
# OPENAI_REALTIME_MODEL=gpt-realtime
# PHONE_MAX_CALL_MS=720000
# PHONE_MAX_CALLS_PER_HOUR=120
