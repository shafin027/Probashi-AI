# ---- AI (at least one) ----
# Claude reads documents and answers questions when set (preferred).
ANTHROPIC_API_KEY=
# OpenAI powers natural Bangla voice (STT/TTS) and memory embeddings, and is the
# fallback AI for analysis/chat (or the only one if no Anthropic key).
OPENAI_API_KEY=
# Optional model overrides
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-5-mini
# OPENAI_TTS_VOICE=marin

# ---- Database: accounts + vector memory (Postgres with pgvector) ----
# Neon / Supabase / Vercel Postgres connection string. Required in production for accounts.
DATABASE_URL=
# Local dev only: embedded Postgres (PGlite) is used automatically when DATABASE_URL is empty.

# ---- Security ----
# 32+ random characters; encrypts paid reports. Generate: openssl rand -base64 48
REPORT_SECRET=
# Extra allowed origins for API calls (comma-separated), e.g. a custom domain.
# ALLOWED_ORIGINS=https://probashi.ai
# Token for the detailed /api/health report (16+ chars), sent as x-health-token.
HEALTH_TOKEN=
# Shared rate limits across serverless instances (recommended in production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Global daily cap on AI calls (protects your bill).
AI_DAILY_LIMIT=2000

# ---- Payments ----
# demo = no real charge. live requires the bKash/SSLCommerz integration (not enabled yet).
PAYMENT_MODE=demo
