{
  "name": "probashi-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI safety copilot for Bangladeshi migrant workers and their families",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "node --test --experimental-strip-types lib/*.test.ts",
    "test:integration": "bash tests/run-integration.sh",
    "test:e2e": "bash tests/run-e2e.sh",
    "test:all": "npm run lint && npm test && npm run build && npm run test:integration && npm run test:e2e",
    "test:live": "node tests/live.mjs",
    "predeploy": "npm run test:all && npm run test:live"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-pgvector": "^0.0.12",
    "next": "^16.4.3",
    "openai": "^7.43.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
